# Gentoo x32 stage4 (systemd) + Xfce4, with the x32-overlay resynced and
# surf built at -Os (webkit-gtk needs less memory at -Os).
#
# Build context is the repository root; the shared images/stage4-common/portage
# configuration was installed by the stage4-systemd base image.
FROM docker.io/kennycheng/gentoo-stage4:x32-systemd

ARG MAKEOPTS
ARG EMERGE_DEFAULT_OPTS

# Force a fresh overlay checkout: this image exists to test updated overlay
# ebuilds/patches, so a cached checkout must not be reused.
RUN emerge-webrsync \
    && rm -rf /var/db/repos/x32-overlay \
    && emerge --sync x32-overlay

# Install packages one by one: an unresolvable optional piece (e.g. a USE
# flag whose dependency only exists ~arch) should not sink the whole image.
RUN for pkg in xfce-base/xfce4-meta net-misc/networkmanager gnome-extra/nm-applet; do \
        emerge --quiet --noreplace "$pkg" || echo "::warning::could not install $pkg"; \
    done \
    && rm -rf /var/cache/distfiles/*

RUN sed -i 's/COMMON_FLAGS="-O2 -pipe/COMMON_FLAGS="-Os -pipe/g' /etc/portage/make.conf \
    && emerge --quiet --noreplace www-client/surf \
    && rm -rf /var/cache/distfiles/* \
    && sed -i 's/COMMON_FLAGS="-Os -pipe/COMMON_FLAGS="-O2 -pipe/g' /etc/portage/make.conf
