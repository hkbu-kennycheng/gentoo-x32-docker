# syntax=docker/dockerfile:1
# Gentoo x32 stage3 (systemd) container base.
#
# scripts/fetch-stage3.sh systemd images/stage3-systemd downloads the latest
# upstream stage3 tarball as stage3.tar.xz inside this directory; ADD unpacks
# it (build context is the repository root, see scripts/build.sh).
FROM scratch
ADD images/stage3-systemd/stage3.tar.xz /
RUN echo 'FEATURES="-ipc-sandbox -pid-sandbox -network-sandbox -usersandbox -mount-sandbox -sandbox"' >> /etc/portage/make.conf
RUN echo 'FEATURES="${FEATURES} parallel-install parallel-fetch -merge-sync"' >> /etc/portage/make.conf

CMD ["bash"]
