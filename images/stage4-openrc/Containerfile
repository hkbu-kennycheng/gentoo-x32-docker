# Gentoo x32 stage4 (OpenRC): daily-use desktop, served as a binhost.
#
# Build context is the repository root (scripts/build.sh passes it) so the
# shared images/stage4-common/ portage configuration can be copied in.
FROM docker.io/kennycheng/gentoo-stage3:x32-openrc

ARG MAKEOPTS
ARG EMERGE_DEFAULT_OPTS

# scripts/build.sh passes MAKEOPTS/EMERGE_DEFAULT_OPTS, but an ARG alone does
# not reach the ebuild environment: without these lines portage falls back to
# its defaults (MAKEOPTS unset -> 1 job, EMERGE_DEFAULT_OPTS unset -> no
# --jobs) and multi-hour world builds run effectively serially.
RUN test -n "$MAKEOPTS" && test -n "$EMERGE_DEFAULT_OPTS" \
    && echo "MAKEOPTS=\"$MAKEOPTS\"" >> /etc/portage/make.conf \
    && echo "EMERGE_DEFAULT_OPTS=\"$EMERGE_DEFAULT_OPTS\"" >> /etc/portage/make.conf

RUN echo 'FEATURES="getbinpkg -ipc-sandbox -network-sandbox -pid-sandbox"' >> /etc/portage/make.conf \
    && echo 'USE="-busybox -gnome -gstreamer -gtk-doc -introspection -lua -lz4 -perl -python -ruby -tiff -vala -vulkan -zink X acpi alsa apparmor bluetooth cjk cpu_flags_x86_aes cpu_flags_x86_avx cpu_flags_x86_avx2 cpu_flags_x86_mmx cpu_flags_x86_mmxext cpu_flags_x86_sse cpu_flags_x86_sse2 cpu_flags_x86_sse3 cpu_flags_x86_sse4_1 cpu_flags_x86_sse4_2 cpu_flags_x86_ssse3 curl dbus dist-kernel elogind fcitx4 gles2 input_devices_libinput input_devices_synaptics jpeg lapack lm-sensors lzma opengl openh264 pulseaudio -system-mitkrb5 udev unicode v4l vaapi video_cards_amdgpu video_cards_i915 video_cards_intel video_cards_nouveau video_cards_radeon video_cards_radeonsi vim-syntax wayland webp xinerama"' >> /etc/portage/make.conf \
    && echo 'ACCEPT_LICENSE="@BINARY-REDISTRIBUTABLE"' >> /etc/portage/make.conf \
    && echo 'BINPKG_FORMAT="gpkg"' >> /etc/portage/make.conf \
    && getuto

# Bootstrap git without its Rust implementation: the x32 Rust toolchain is only
# available from the x32-overlay (below), which needs git to sync.
RUN emerge-webrsync -q \
    && USE="-rust" emerge -qu --noreplace dev-vcs/git eselect-repository

# Always fetch the overlay's latest commit: a cached repository checkout is
# never reused, so builds see current patches and ebuilds. scripts/build.sh
# passes the overlay's HEAD commit; it is part of the command line so a new
# overlay commit invalidates this layer.
ARG X32_OVERLAY_COMMIT
RUN test -n "$X32_OVERLAY_COMMIT" \
    && echo "Syncing x32-overlay at $X32_OVERLAY_COMMIT" \
    && eselect repository add x32-overlay git https://github.com/hkbu-kennycheng/x32-overlay.git \
    && rm -rf /var/db/repos/x32-overlay \
    && emerge --sync x32-overlay

# The x32-overlay carries the ABI-correct x32 patches (ruby coroutines, etc.)
# and, via the x32 profile, the x32-capable rust-bin. Wire the patch tree so
# eapply_user applies it; profile.bashrc also honours this path.
RUN mkdir -p /etc/portage/patches \
    && rmdir /etc/portage/patches \
    && ln -s /var/db/repos/x32-overlay/profiles/x32/patches /etc/portage/patches

# Shared build-host configuration (USE flags, keywords, per-package settings).
COPY images/stage4-common/portage/ /etc/portage/

COPY scripts/emerge-world.sh /usr/local/bin/emerge-world.sh

# p11-kit's `trust extract --format=java-cacerts` segfaults for every format
# on x32 (p11-kit 0.26.4 and 0.26.6 alike), which makes baselayout-java's
# postinst fail. That postinst is guarded by [[ ! -f cacerts ]], so seed the
# file first; the official bundle can be regenerated later from a working
# x32 p11-kit.
RUN mkdir -p /etc/ssl/certs/java && : > /etc/ssl/certs/java/cacerts

# The helper retries once with `emerge --resume` so one transient failure does
# not discard the multi-hour build, and still fails if the retry fails.
#
# cargo-c is not excluded any more: the overlay's 0.10.16 builds on x32, and
# without it librsvg 2.62.4 (BDEPEND >=dev-util/cargo-c-0.10.10) falls back to
# ::gentoo 2.58.5-r1, which does not link for x32.
RUN sh /usr/local/bin/emerge-world.sh
