# Gentoo x32 stage4 (systemd): daily-use desktop, served as a binhost.
#
# Build context is the repository root (scripts/build.sh passes it) so the
# shared images/stage4-common/ portage configuration can be copied in.
FROM docker.io/kennycheng/gentoo-stage3:x32-systemd

ARG MAKEOPTS
ARG EMERGE_DEFAULT_OPTS
ARG TERM=linux

RUN echo 'FEATURES="getbinpkg -ipc-sandbox -network-sandbox -pid-sandbox"' >> /etc/portage/make.conf \
    && echo 'USE="-busybox -gnome -gstreamer -gtk-doc -introspection -lua -lz4 -perl -python -ruby -tiff -vala vulkan -zink X acpi alsa apparmor bluetooth cjk cpu_flags_x86_aes cpu_flags_x86_avx cpu_flags_x86_avx2 cpu_flags_x86_mmx cpu_flags_x86_mmxext cpu_flags_x86_sse cpu_flags_x86_sse2 cpu_flags_x86_sse3 cpu_flags_x86_sse4_1 cpu_flags_x86_sse4_2 cpu_flags_x86_ssse3 curl dbus dist-kernel elogind fcitx4 gles2 input_devices_libinput input_devices_synaptics jpeg lapack lm-sensors lzma opengl openh264 pipewire python_targets_python3_13 -system-mitkrb5 truetype udev unicode v4l vaapi video_cards_amdgpu video_cards_i915 video_cards_intel video_cards_nouveau video_cards_radeon video_cards_radeonsi video_cards_zink vim-syntax wayland webp xinerama"' >> /etc/portage/make.conf \
    && echo 'ACCEPT_LICENSE="@BINARY-REDISTRIBUTABLE"' >> /etc/portage/make.conf \
    && echo 'BINPKG_FORMAT="gpkg"' >> /etc/portage/make.conf \
    && getuto

# Bootstrap git without its Rust implementation: the x32 Rust toolchain is only
# available from the x32-overlay (below), which needs git to sync.
RUN emerge-webrsync -q \
    && USE="-rust" emerge -qu --noreplace dev-vcs/git eselect-repository

RUN eselect repository add x32-overlay git https://github.com/hkbu-kennycheng/x32-overlay.git \
    && emerge --sync x32-overlay

# The x32-overlay carries the ABI-correct x32 patches (ruby coroutines, etc.)
# and, via the x32 profile, the x32-capable rust-bin. Wire the patch tree so
# eapply_user applies it; profile.bashrc also honours this path.
RUN mkdir -p /etc/portage/patches \
    && rmdir /etc/portage/patches \
    && ln -s /var/db/repos/x32-overlay/profiles/x32/patches /etc/portage/patches

# Shared build-host configuration (USE flags, keywords, per-package settings).
COPY images/stage4-common/portage/ /etc/portage/

RUN emerge -qDNu @world \
    --exclude dev-util/cargo-c --exclude dev-vcs/git \
    --exclude dev-lang/rust-bin $(grep -v "^#" /etc/portage/sets/stage4) \
    && rm -rf /var/cache/distfiles/*
