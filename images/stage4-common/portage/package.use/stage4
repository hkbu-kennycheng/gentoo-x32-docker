# Per-package USE flags for the x32 daily-use binhost (both flavours).

# git's Rust implementation does not build for x32: cargo-meson.sh invokes
# rustc without CARGO_BUILD_TARGET, so the Rust objects are ELF64 and fail to
# link into the ELF32 binaries.
dev-vcs/git -rust

# Python's bluetooth headers need bluez; bluez needs glib, while the Python
# being built is itself needed by gobject-introspection -> glib. Break that
# cycle (matters for the openrc image, which does not build
# gobject-introspection[python]).
dev-lang/python -bluetooth

app-i18n/fcitx-qt qt5
dev-libs/libxml2 python
media-libs/libsdl2 -fcitx4
dev-qt/qtgui egl eglfs
app-text/xmlto text
dev-libs/boost -context
app-containers/waydroid -apparmor
app-crypt/gcr gtk
media-libs/harfbuzz icu
media-libs/freetype harfbuzz
app-text/poppler cairo
media-libs/gegl cairo
media-libs/allegro vorbis png
sys-libs/libcap static-libs
virtual/imagemagick-tools tiff
media-gfx/imagemagick tiff
media-sound/mpg123 -pulseaudio
dev-python/pillow -webp -truetype
# -ukify: UKIs need an EFI stub, which x32 masks (-efistub). uki would pull
# sys-apps/systemd[boot] onto the openrc image and conflict with systemd-utils.
sys-kernel/installkernel dracut -ukify -uki
dev-libs/libutf8proc -cjk
net-libs/ngtcp2 gnutls

# Xfce4 desktop session stack.
dev-libs/glib introspection
xfce-base/xfce4-panel dbusmenu
xfce-base/thunar udisks
gnome-base/gvfs udisks
net-misc/networkmanager dhcpcd
gui-libs/libwlembed gtk

# systemd flavour (ignored by portage when the package is not installed).
sys-apps/systemd boot policykit
media-video/pipewire bluetooth dbus extra ffmpeg fftw flatpak pipewire-alsa sound-server v4l
