# Per-package USE flags for the x32 daily-use binhost.

# git's Rust implementation does not build for x32 (cargo-meson.sh does not
# set CARGO_BUILD_TARGET=x86_64-unknown-linux-gnux32, so the Rust objects are
# ELF64 and fail to link into the ELF32 binaries).
dev-vcs/git -rust

